PORT=5000
NODE_ENV=development

# MongoDB Connection (Local or MongoDB Atlas)
# Local: mongodb://localhost:27017/school_admission
# Atlas: mongodb+srv://<username>:<password>@<cluster-url>/school_admission?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/school_admission?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Application Fee Configuration
REGISTRATION_FEE=500

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
